# dbt profile for this project.
#
# dbt looks for profiles.yml in ~/.dbt/profiles.yml, NOT inside the project
# folder (that's why this file is named .example — copy it, don't rename
# and commit the real one, in case the path or credentials ever change).
#
# Setup:
#   mkdir -p ~/.dbt
#   cp dbt_retail/profiles.yml.example ~/.dbt/profiles.yml
#   (then edit the `path` below to match your machine if needed)

retail_forecasting:
  target: dev
  outputs:
    dev:
      type: sqlite
      threads: 1
      database: 'database'
      schema: 'main'
      schemas_and_paths:
        main: '/absolute/path/to/retail-demand-forecasting/data/processed/warehouse.db'
      schema_directory: '/absolute/path/to/retail-demand-forecasting/data/processed'
